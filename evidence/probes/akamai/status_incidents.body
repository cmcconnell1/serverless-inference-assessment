. We will share additional updates as we have more information.", "incident_id": "xbzbh7vc62jx", "created_at": "2026-07-31T17:49:13.732Z", "updated_at": "2026-07-31T17:49:13.732Z", "display_at": "2026-07-31T17:49:13.732Z", "affected_components": [{"code": "v8zpnn61fcdm", "name": "Regions - US-East (Newark)", "old_status": "operational", "new_status": "operational"}, {"code": "s8355f9s5hpx", "name": "Regions - US-Central (Dallas)", "old_status": "operational", "new_status": "operational"}, {"code": "v5mcdxdt9dtv", "name": "Regions - US-West (Fremont)", "old_status": "operational", "new_status": "operational"}, {"code": "ss2n92gy5xkk", "name": "Regions - US-Southeast (Atlanta)", "old_status": "operational", "new_status": "operational"}, {"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": "operational"}, {"code": "43zk807gj6fx", "name": "Regions - US-ORD (Chicago)", "old_status": "operational", "new_status": "operational"}, {"code": "5lw6b06mjfww", "name": "Regions - US-SEA (Seattle)", "old_status": "operational", "new_status": "operational"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "operational", "new_status": "operational"}, {"code": "pkd875v4jmzl", "name": "Regions - US-MIA (Miami)", "old_status": "operational", "new_status": "operational"}, {"code": "7xrbxwctvj1h", "name": "Regions - US-LAX (Los Angeles)", "old_status": "operational", "new_status": "operational"}, {"code": "8xrfbhs3qrxq", "name": "Regions - IN-BOM-2 (Mumbai 2)", "old_status": "operational", "new_status": "operational"}, {"code": "2vzdgh6ysfzz", "name": "Regions - US-DEN (Denver)", "old_status": "operational", "new_status": "operational"}, {"code": "4j2hqzkcb5bw", "name": "Regions - US-HOU (Houston)", "old_status": "operational", "new_status": "operational"}, {"code": "x1293sz7zyff", "name": "Regions - US-IAD-2 (Washington 2)", "old_status": "operational", "new_status": "operational"}], "deliver_notificatio