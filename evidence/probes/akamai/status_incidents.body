6fx4ttdx2kf", "name": "DE-FRA-2 (Frankfurt 2) Linode Kubernetes Engine", "status": "operational", "created_at": "2025-04-14T17:21:04.151Z", "updated_at": "2026-06-22T00:00:10.355Z", "position": 29, "description": null, "showcase": false, "start_date": "2025-04-14", "group_id": "lplvcng25jv0", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "vxp9y8rmp0vh", "name": "SG-SIN-2 (Singapore 2) Linode Kubernetes Engine", "status": "operational", "created_at": "2025-04-14T17:21:27.114Z", "updated_at": "2026-06-22T00:00:10.394Z", "position": 30, "description": null, "showcase": false, "start_date": "2025-04-14", "group_id": "lplvcng25jv0", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "5bqgy49ck8pz", "name": "JP-TYO-3 (Tokyo 3) Linode Kubernetes Engine", "status": "operational", "created_at": "2025-04-14T17:21:49.273Z", "updated_at": "2026-06-22T00:00:10.438Z", "position": 31, "description": null, "showcase": false, "start_date": "2025-04-14", "group_id": "lplvcng25jv0", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "63vy28y94b05", "name": "Emerging Service Issue - Support Phone Line", "status": "resolved", "created_at": "2026-06-03T14:22:17.991Z", "updated_at": "2026-06-04T15:51:36.682Z", "monitoring_at": null, "resolved_at": "2026-06-04T15:51:36.666Z", "impact": "none", "shortlink": "https://stspg.io/vxkqxg5q7xrr", "started_at": "2026-06-03T14:22:17.985Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "xkvs32r1mnw9", "status": "resolved", "body": "The upstream issue has been resolved, and our Support phone line should now be fully functional again.", "incident_id": "63vy28y94b05", "created_at": "2026-06-04T15:51:36.666Z", "updated_at": "2026-06-04T15:51:36.666Z", "display_at": "2026-06-04T15:51:36.666Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "dbqjj5q431qq", "status": "investigating", "body": "Our team is continuing to investigate an upstream service issue affecting our Support phone line. While stability of the service has improved, we have not yet identified the cause of the issue. We will share additional updates as we have more information.\n\nIf you are having difficulty reaching us over the phone during this time, please <a href=\"https://cloud.linode.com/support/tickets?dialogOpen=true\">open a Support ticket from the Cloud Manager.</a>", "incident_id": "63vy28y94b05", "created_at": "2026-06-03T18:33:54.156Z", "updated_at": "2026-06-03T18:33:54.156Z", "display_at": "2026-06-03T18:33:54.156Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "c42q2cydjg0n", "status": "investigating", "body": "Our team is investigating an upstream emerging service issue affecting our Support phone line due to problems with an upstream provider. We will share additional updates as we have more information.\n\nIf you are having difficulty reaching us over the phone during this time, please reach us through a ticket.", "incident_id": "63vy28y94b05", "created_at": "2026-06-03T14:22:18.028Z", "updated_at": "2026-06-03T14:22:18.028Z", "display_at": "2026-06-03T14:22:18.028Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "qrxbxvrn9h54", "name": "Service Issue - Block Storage Newark, US", "status": "postmortem", "created_at": "2026-06-03T08:58:08.085Z", "updated_at": "2026-06-04T12:56:31.821Z", "monitoring_at": "2026-06-03T11:25:15.004Z", "resolved_at": "2026-06-04T09:11:58.023Z", "impact": "minor", "shortlink": "https://stspg.io/yy6wrsdk0ggj", "started_at": "2026-06-03T08:58:08.072Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "lwyzq16sfr1t", "status": "postmortem", "body": "Between 22:50 UTC on June 2, 2026 and 19:00 UTC on June 3, 2026, some customers experienced intermittent performance degradation and long access times when interacting with the Compute Block Storage cluster in Newark, US. During this period, intermittent component instability triggered intensive background recovery operations. This elevated system load resulted in a temporary degradation of data redundancy, higher read/write latency, and reduced throughput for the affected volumes.\u00a0\n\nTo mitigate the impact, Akamai successfully restored the affected storage drives to operation, stabilizing the cluster and eliminating active customer impact. Following this, additional actions aim to fully restore standard system redundancy.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-04T12:55:52.810Z", "updated_at": "2026-06-04T12:56:31.818Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 3rd incident: https://stspg.io/yy6wrsdk0ggj", "tweet_id": null}, {"id": "dxx9h54gpbc7", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Block Storage service in Newark, US, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-04T09:11:58.023Z", "updated_at": "2026-06-04T09:11:58.023Z", "display_at": "2026-06-04T09:11:58.023Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "k60b7yt4v193", "status": "monitoring", "body": "At this time we have been able to correct the issues affecting the Block Storage service. We will be monitoring this to ensure that it remains stable. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-03T15:44:24.509Z", "updated_at": "2026-06-03T15:44:24.509Z", "display_at": "2026-06-03T15:44:24.509Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "s584fsgl65th", "status": "investigating", "body": "Our team is investigating an issue affecting the Block Storage service in our Newark, US data center. During this time, users may experience connection timeouts, latency and errors with this service. We will share additional updates as we have more information.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-03T12:55:49.892Z", "updated_at": "2026-06-03T12:55:49.892Z", "display_at": "2026-06-03T12:55:49.892Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "zy77p1wczrbm", "status": "monitoring", "body": "At this time we have been able to correct the issues affecting the Block Storage service. We will be monitoring this to ensure that it remains stable. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-03T11:25:15.004Z", "updated_at": "2026-06-03T11:25:15.004Z", "display_at": "2026-06-03T11:25:15.004Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "46gqyxd95khh", "status": "investigating", "body": "We are continuing to investigate this issue.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-03T10:53:00.747Z", "updated_at": "2026-06-03T10:53:00.747Z", "display_at": "2026-06-03T10:53:00.747Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "38kv8vmp5ndb", "status": "investigating", "body": "Our team is investigating an issue affecting the Block Storage service in our Newark, US data center. During this time, users may experience connection timeouts, latency and errors with this service. We will share additional updates as we have more information.", "incident_id": "qrxbxvrn9h54", "created_at": "2026-06-03T08:58:08.210Z", "updated_at": "2026-06-03T08:58:08.210Z", "display_at": "2026-06-03T08:58:08.210Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "zq4h2zstlwhz", "name": "US-East (Newark) Block Storage", "status": "operational", "created_at": "2018-09-12T17:54:53.591Z", "updated_at": "2026-06-03T15:44:24.466Z", "position": 1, "description": null, "showcase": false, "start_date": null, "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "ggqhkqmfwpkf", "name": "Service Issue - Object Storage", "status": "postmortem", "created_at": "2026-05-29T18:23:03.082Z", "updated_at": "2026-06-08T09:14:10.869Z", "monitoring_at": null, "resolved_at": "2026-05-29T18:23:03.129Z", "impact": "none", "shortlink": "https://stspg.io/g2r7m3pd2s6z", "started_at": "2026-05-29T18:23:03.075Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "cy8gk4xp2v3w", "status": "postmortem", "body": "Between 10:13 UTC and 10:22 UTC on May 29, 2026, customers using Object Storage \\(OBJ\\) in London experienced 5xx errors when trying to access content stored in that location. While attempting to isolate a separate packet loss issue, Akamai sequentially upgraded 2 pairs of routers. The first pair of routers was upgraded successfully, but due to human error the second router pair's upgrade command was executed before the first pair had completed route convergence. This resulted in a temporary loss of routing paths for OBJ traffic in the London datacenter.\n\nThe issue was quickly detected via an automated alert, and service was restored automatically once the firmware upgrades and routing convergence completed.\n\nAkamai's Change Management Policy requires all router upgrade activities to be performed in accordance with established procedures and predefined implementation instructions. Akamai will conduct refresher training on the Change Management Policy to reinforce compliance with the required processes and ensure strict adherence going forward.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "ggqhkqmfwpkf", "created_at": "2026-06-08T09:13:45.156Z", "updated_at": "2026-06-08T09:14:10.867Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 29th incident: https://stspg.io/g2r7m3pd2s6z", "tweet_id": null}, {"id": "dkg06hyx787j", "status": "resolved", "body": "Starting at around 10:07 UTC on May 29, 2026, Object Storage in London became unavailable. Affected customers were unable to access Object Storage during this time, and may have seen 500 or similar errors.\n\nThis occurred as the result of an issue with a planned router upgrade. The router has since been brought back online, and we can confirm that the issue was mitigated at 10:19 UTC on May 29, 2026 and is no longer occurring.\n\nWe apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "ggqhkqmfwpkf", "created_at": "2026-05-29T18:23:03.129Z", "updated_at": "2026-05-29T18:23:03.129Z", "display_at": "2026-05-29T18:23:03.129Z", "affected_components": [{"code": "qktsh0z87vfd", "name": "Object Storage - GB-LON (London 2) Object Storage", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "qktsh0z87vfd", "name": "GB-LON (London 2) Object Storage", "status": "operational", "created_at": "2025-04-14T16:44:21.528Z", "updated_at": "2026-04-29T19:19:35.869Z", "position": 23, "description": null, "showcase": false, "start_date": "2025-04-14", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "fztyx3ts2xk2", "name": "Service Issue - Paris (FR-PAR3)", "status": "postmortem", "created_at": "2026-05-22T11:22:31.923Z", "updated_at": "2026-06-05T11:02:17.026Z", "monitoring_at": "2026-05-22T13:14:32.000Z", "resolved_at": "2026-05-26T06:15:25.625Z", "impact": "minor", "shortlink": "https://stspg.io/3k629vrcrvvf", "started_at": "2026-05-22T11:22:31.903Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "pftxyg7wdk4w", "status": "postmortem", "body": "On May 22, 2026 between approximately 09:10 and 11:30 UTC, connectivity issues were experienced in Paris \\(FR-PAR3\\) datacenter. During the impact window, customers may have experienced intermittent connection timeouts and errors for services deployed in the Paris datacenter.\n\nOur investigation established that connectivity to the host was affected as both of our transits in FRA3 flapped at the exact same time and that triggered high route churn which in result caused packet loss. On analyzing further on why both of our transits flapped at the exact same time, we engaged our Data Center provider and it was identified that during a planned maintenance in the data center, both operator rooms, which support network connectivity, lost power for several minutes, resulting in a complete isolation of the availability zone.\n\nWe apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence.\n\n\u00a0This summary provides an overview of our current understanding of the incident, given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "fztyx3ts2xk2", "created_at": "2026-06-05T11:01:36.624Z", "updated_at": "2026-06-05T11:02:17.023Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 22nd incident: https://stspg.io/3k629vrcrvvf", "tweet_id": null}, {"id": "807xf4phn2r2", "status": "resolved", "body": "We haven\u2019t observed any additional connectivity issues in our Paris data center, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "fztyx3ts2xk2", "created_at": "2026-05-26T06:15:25.625Z", "updated_at": "2026-05-26T06:15:25.625Z", "display_at": "2026-05-26T06:15:25.625Z", "affected_components": [{"code": "19fvt94q0t57", "name": "Regions - FR-PAR (Paris)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "17qsc4ydv0wq", "status": "monitoring", "body": "The issue subsided by 11:30 UTC on May 22, 2026, the impact was observed between 09:10 UTC to 11:30 UTC on May 22, 2026. We are actively monitoring to ensure that the service remains stable . If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "fztyx3ts2xk2", "created_at": "2026-05-22T13:14:32.976Z", "updated_at": "2026-05-22T13:26:17.005Z", "display_at": "2026-05-22T13:14:32.000Z", "affected_components": [{"code": "19fvt94q0t57", "name": "Regions - FR-PAR (Paris)", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "8vrjk0c24g7p", "status": "investigating", "body": "We are continuing to investigate the issue", "incident_id": "fztyx3ts2xk2", "created_at": "2026-05-22T12:24:32.575Z", "updated_at": "2026-05-22T12:24:32.575Z", "display_at": "2026-05-22T12:24:32.575Z", "affected_components": [{"code": "19fvt94q0t57", "name": "Regions - FR-PAR (Paris)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "rgwdrnl34pbq", "status": "investigating", "body": "We are investigating a service issue affecting traffic in our Paris data center. We will share additional updates as we have more information.", "incident_id": "fztyx3ts2xk2", "created_at": "2026-05-22T11:22:32.089Z", "updated_at": "2026-05-22T11:22:32.089Z", "display_at": "2026-05-22T11:22:32.089Z", "affected_components": [{"code": "19fvt94q0t57", "name": "Regions - FR-PAR (Paris)", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "19fvt94q0t57", "name": "FR-PAR (Paris)", "status": "operational", "created_at": "2023-07-05T17:53:40.374Z", "updated_at": "2026-08-19T05:30:20.350Z", "position": 10, "description": null, "showcase": false, "start_date": "2023-07-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "krnvfzp0dwr2", "name": "Emerging Service Issue - GPU Deployment", "status": "postmortem", "created_at": "2026-05-19T19:48:40.689Z", "updated_at": "2026-05-25T17:36:04.292Z", "monitoring_at": "2026-05-19T21:58:28.000Z", "resolved_at": "2026-05-20T00:27:36.575Z", "impact": "none", "shortlink": "https://stspg.io/dmz24zjbxfj5", "started_at": "2026-05-19T19:48:40.680Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "3hlj4pg0ccbb", "status": "postmortem", "body": "On May 19, 2026, at 18:26 UTC, we identified an issue impacting the creation and re-provisioning of Linode instances using any of the four RTX PRO 6000 Blackwell \\(g3-gpu-rtxpro6000-blackwell\\) plans, resulting in API errors. These failures caused a denial of service for customers attempting to deploy g3-gpu-rtxpro6000-blackwell instances via the Cloud Manager or API.\n\nAfter the initial investigation SMEs determined that the cause of the issue was a logic error within a recent APIv4 update. Specifically, a validation check intended only for RDMA-enabled networking was incorrectly applied to standard Blackwell GPU plans. This caused the API to reject creation requests that did not meet specific RDMA configurations, even when those configurations were not required for the selected plan.\n\nWith the issue identified, our engineering team developed and tested a hotfix to correct the plan-validation logic. Deployment of the fix began shortly after, and broader customer impact was mitigated as of 21:36 UTC on May 19, 2026, following successful verification in all regions.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing, and we are currently reviewing our automated testing to prevent similar recurrences.", "incident_id": "krnvfzp0dwr2", "created_at": "2026-05-25T17:35:31.602Z", "updated_at": "2026-05-25T17:36:04.290Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 19th incident: https://stspg.io/dmz24zjbxfj5", "tweet_id": null}, {"id": "nvmswkn9tzjy", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the GPU provisioning in all regions, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "krnvfzp0dwr2", "created_at": "2026-05-20T00:27:36.575Z", "updated_at": "2026-05-20T00:27:36.575Z", "display_at": "2026-05-20T00:27:36.575Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "6prf4cg0nc3j", "status": "monitoring", "body": "At this time we have been able to correct the issues affecting GPU provisioning in all regions as of 21:27 UTC. on May 19th, 2026. We will be monitoring this to ensure that it remains stable. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "krnvfzp0dwr2", "created_at": "2026-05-19T21:58:28.142Z", "updated_at": "2026-05-19T22:01:50.593Z", "display_at": "2026-05-19T21:58:28.000Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "48xhqqkfjbnt", "status": "identified", "body": "The issue with deployment of RTX PRO 6000 Blackwell plans appears to have started around 15:00 UTC on May 19, 2026. We are actively working to deploy an API hotfix that is expected to be rolled out within 1 hour. We apologize for the impact.", "incident_id": "krnvfzp0dwr2", "created_at": "2026-05-19T21:06:37.665Z", "updated_at": "2026-05-19T21:06:37.665Z", "display_at": "2026-05-19T21:06:37.665Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "5s6thxl0694g", "status": "identified", "body": "Our team is investigating an emerging service issue affecting GPU provisioning in all regions. At this time deployment of RTX PRO 6000 Blackwell plans in unavailable. We will share additional updates as we have more information.", "incident_id": "krnvfzp0dwr2", "created_at": "2026-05-19T19:48:40.751Z", "updated_at": "2026-05-19T19:48:40.751Z", "display_at": "2026-05-19T19:48:40.751Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "dj3h400zlydn", "name": "Service Issue - [Linodes and Linode Kubernetes Engine (LKE)] - [All Regions]", "status": "postmortem", "created_at": "2026-05-16T00:42:02.823Z", "updated_at": "2026-05-20T21:10:19.344Z", "monitoring_at": null, "resolved_at": "2026-05-16T01:43:19.609Z", "impact": "none", "shortlink": "https://stspg.io/1ch8htmrzqgx", "started_at": "2026-05-16T00:42:02.722Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "1l06fcdcdwyz", "status": "postmortem", "body": "On May 15, 2026, at 18:18 UTC, we identified an issue impacting the deployment of Linodes that relied on StackScripts \\(including all newly created Linode Kubernetes Engine \\(LKE\\) and \\(LKE-E\\) nodes\\), resulting in deployment failures. These deployment failures resulted in Linodes created with StackScripts to be unbootable and LKE autoscaling or recycling activity to fail.\n\nSubject matter experts determined that the cause of the issue was the removal of a credential parser during a recent update on compute hosts. This credential parser is used in the process of decoding StackScripts and its removal caused Linode deployments relying on StackScripts to fail.\n\nWith the issue identified, we began to test a rollback at 01:10 UTC on May 16, 2026\u00a0 and a reduction in failures was noted at 01:20 UTC. We mitigated the broader customer impact by\u00a0 01:30 UTC on May 16, 2026.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "dj3h400zlydn", "created_at": "2026-05-20T19:15:41.584Z", "updated_at": "2026-05-20T21:10:19.342Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 15th incident: https://stspg.io/1ch8htmrzqgx", "tweet_id": null}, {"id": "v1w94cs9fyyh", "status": "resolved", "body": "This incident has been resolved.", "incident_id": "dj3h400zlydn", "created_at": "2026-05-16T01:43:19.609Z", "updated_at": "2026-05-16T01:43:19.609Z", "display_at": "2026-05-16T01:43:19.609Z", "affected_components": [{"code": "v8zpnn61fcdm", "name": "Regions - US-East (Newark)", "old_status": "operational", "new_status": "operational"}, {"code": "s8355f9s5hpx", "name": "Regions - US-Central (Dallas)", "old_status": "operational", "new_status": "operational"}, {"code": "v5mcdxdt9dtv", "name": "Regions - US-West (Fremont)", "old_status": "operational", "new_status": "operational"}, {"code": "ss2n92gy5xkk", "name": "Regions - US-Southeast (Atlanta)", "old_status": "operational", "new_status": "operational"}, {"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": "operational"}, {"code": "43zk807gj6fx", "name": "Regions - US-ORD (Chicago)", "old_status": "operational", "new_status": "operational"}, {"code": "ptln4fx0jhrt", "name": "Regions - CA-Central (Toronto)", "old_status": "operational", "new_status": "operational"}, {"code": "jzjmxld11n92", "name": "Regions - EU