ed_at": "2025-04-08T13:38:55.419Z", "updated_at": "2026-08-19T05:30:41.069Z", "position": 34, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "2vzdgh6ysfzz", "name": "US-DEN (Denver)", "status": "operational", "created_at": "2025-04-08T13:39:37.373Z", "updated_at": "2026-08-19T05:30:42.016Z", "position": 35, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "9qsy3z48wlm7", "name": "DE-HAM (Hamburg)", "status": "operational", "created_at": "2025-04-08T13:40:02.407Z", "updated_at": "2026-08-19T05:30:42.804Z", "position": 36, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "4j2hqzkcb5bw", "name": "US-HOU (Houston)", "status": "operational", "created_at": "2025-04-08T13:41:51.324Z", "updated_at": "2026-08-19T05:30:43.574Z", "position": 37, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "z8lp5jw3mjpb", "name": "MY-KUL (Kuala Lumpur)", "status": "operational", "created_at": "2025-04-08T13:42:25.784Z", "updated_at": "2026-08-19T05:30:44.821Z", "position": 38, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "qks0rqykcp34", "name": "FR-MRS (Marseille)", "status": "operational", "created_at": "2025-04-08T13:43:42.266Z", "updated_at": "2026-08-19T05:30:45.455Z", "position": 39, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "kzl6jczkb2tk", "name": "MX-QRO (Queretaro)", "status": "operational", "created_at": "2025-04-08T13:44:50.559Z", "updated_at": "2026-08-19T05:30:46.696Z", "position": 40, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "3rsd4fh24z48", "name": "CL-SCL (Santiago)", "status": "operational", "created_at": "2025-04-08T13:45:05.933Z", "updated_at": "2026-08-19T05:30:47.679Z", "position": 41, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "gbwj4lm4196m", "name": "FR-PAR-2 (Paris 2)", "status": "operational", "created_at": "2026-01-06T15:34:24.715Z", "updated_at": "2026-08-19T05:30:48.666Z", "position": 42, "description": null, "showcase": false, "start_date": "2026-01-06", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "x1293sz7zyff", "name": "US-IAD-2 (Washington 2)", "status": "operational", "created_at": "2026-05-05T19:15:39.919Z", "updated_at": "2026-08-19T05:30:49.359Z", "position": 43, "description": null, "showcase": false, "start_date": "2026-05-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "grdjlrm3z9h8", "name": "Service Issue - Debian Package Availability", "status": "postmortem", "created_at": "2026-06-24T16:27:43.727Z", "updated_at": "2026-06-24T17:45:23.940Z", "monitoring_at": null, "resolved_at": "2026-06-24T16:27:43.772Z", "impact": "none", "shortlink": "https://stspg.io/jkjdyn87l4ny", "started_at": "2026-06-24T16:27:43.723Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "95kyqkprstz2", "status": "postmortem", "body": "Our upstream third-party Debian repo failed to sync with their own upstream repo chain for an unknown reason. The InRelease files for Debian packages were left to expire starting at approximately 08:12 UTC on June 24, 2026, preventing any Debian packages from getting installed. We didn't have programmatic visibility at that time to know that these files were unable to download or if the expiration date in the InRelease files had been reached. We mitigated the issue at approximately 12:35 UTC on June 24, 2026, by updating which repo we are syncing Debian packages from and purging the stale InRelease files from our cache. We are working to integrate system visibility and alerting around expiration dates of these files in addition to switching to a more reliable upstream repo, i.e. Debian's official repos.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "grdjlrm3z9h8", "created_at": "2026-06-24T17:39:09.420Z", "updated_at": "2026-06-24T17:45:23.938Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 24th incident: https://stspg.io/jkjdyn87l4ny", "tweet_id": null}, {"id": "mj9c275z5g67", "status": "resolved", "body": "Between approximately 08:12 UTC and 12:35 UTC on June 24, 2026, attempting to create/autoscale Linodes using a Debian distribution may have failed due to a stale InRelease file in an upstream repository. We have mitigated the issue by updating our mirror endpoint to a healthy repository. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "grdjlrm3z9h8", "created_at": "2026-06-24T16:27:43.772Z", "updated_at": "2026-06-24T16:27:43.772Z", "display_at": "2026-06-24T16:27:43.772Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "nkkf1pkgkrh4", "name": "Emerging Service Issue - Networking - US-MIA (Miami)", "status": "postmortem", "created_at": "2026-06-16T14:29:21.699Z", "updated_at": "2026-06-22T18:54:54.515Z", "monitoring_at": null, "resolved_at": "2026-06-16T17:18:40.237Z", "impact": "none", "shortlink": "https://stspg.io/9dz2yytyr12x", "started_at": "2026-06-16T14:29:21.687Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "glyctlylc1j5", "status": "postmortem", "body": "On June 16, 2026 Akamai investigated an\u00a0 instance of performance degradation and connectivity slowness observed affecting applications within the Miami compute environment. This event occurred between around 13:37 UTC and 14:20 UTC on June 16, 2026.\u00a0 The Investigation revealed a configuration change on an Akamai device in Miami triggered an underlying vendor software defect within the routing platform's operating system.\u00a0 Actions were taken to mitigate the impact and restore intended routing paths.\n\nTo prevent any further recurrence, we have temporarily suspended related configuration changes.\n\nRoot Cause: During a routine, scheduled configuration update to an aggregated network link, an underlying vendor software defect within the routing platform's operating system was triggered.\n\nWhile the configuration change itself was standard and correct, the software bug caused the router to incorrectly process internal MPLS \\(Multiprotocol Label Switching\\) routing tables. Instead of applying changes only to the targeted link, the software inadvertently cleared the routing instructions for unrelated network interfaces. This unintended removal of routing paths led to the subsequent traffic disruption.\n\nWe apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "nkkf1pkgkrh4", "created_at": "2026-06-22T18:54:27.617Z", "updated_at": "2026-06-22T18:54:54.513Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 16th incident: https://stspg.io/9dz2yytyr12x", "tweet_id": null}, {"id": "qsxwxygrkyjz", "status": "resolved", "body": "We haven\u2019t observed any additional connectivity issues in our US-MIA (Miami) data center, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "nkkf1pkgkrh4", "created_at": "2026-06-16T17:18:40.237Z", "updated_at": "2026-06-16T17:18:40.237Z", "display_at": "2026-06-16T17:18:40.237Z", "affected_components": [{"code": "pkd875v4jmzl", "name": "Regions - US-MIA (Miami)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "6kc2kp87j717", "status": "investigating", "body": "Our team is investigating an emerging service issue affecting networking in US-MIA (Miami). We will share additional updates as we have more information.", "incident_id": "nkkf1pkgkrh4", "created_at": "2026-06-16T14:29:21.764Z", "updated_at": "2026-06-16T14:29:21.764Z", "display_at": "2026-06-16T14:29:21.764Z", "affected_components": [{"code": "pkd875v4jmzl", "name": "Regions - US-MIA (Miami)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "pkd875v4jmzl", "name": "US-MIA (Miami)", "status": "operational", "created_at": "2023-10-16T15:27:22.335Z", "updated_at": "2026-08-19T05:30:31.032Z", "position": 23, "description": null, "showcase": false, "start_date": "2023-10-16", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "bklgtykj0n3n", "name": "Service Issue: Longview", "status": "postmortem", "created_at": "2026-06-16T08:56:14.630Z", "updated_at": "2026-06-19T05:10:04.877Z", "monitoring_at": "2026-06-16T09:48:53.348Z", "resolved_at": "2026-06-16T13:13:59.984Z", "impact": "minor", "shortlink": "https://stspg.io/4r0r9nzw1679", "started_at": "2026-06-16T08:56:14.622Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "1mmjn75zp7kk", "status": "postmortem", "body": "Starting around 23:15 UTC on June 15, 2026, some customers were unable to access the Longview graph dashboard. The investigation revealed that Linodes were unable to reach the Longview endpoint and were failing to report data. The impact was limited to reading the existing reporting data only and there was no permanent reporting data loss due to this issue.\n\nTo mitigate the impact, we manually rebooted identified VM boxes to take effect and resolve Gateway errors. The impact was mitigated at 9:00 UTC on June 16, 2026, following this action. Post-mitigation, all expected data is available in the Longview graph dashboard. We will continue to investigate the root cause and will take appropriate preventive actions. We apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "bklgtykj0n3n", "created_at": "2026-06-16T16:48:34.944Z", "updated_at": "2026-06-19T05:10:04.874Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 16th incident: https://stspg.io/4r0r9nzw1679", "tweet_id": null}, {"id": "bcdwjv1r3vb2", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Longview service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "bklgtykj0n3n", "created_at": "2026-06-16T13:13:59.984Z", "updated_at": "2026-06-16T13:13:59.984Z", "display_at": "2026-06-16T13:13:59.984Z", "affected_components": [{"code": "v3rbxq0mztjx", "name": "Longview", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "mpz1djcl5nxv", "status": "monitoring", "body": "A fix has been implemented and we are monitoring the results.", "incident_id": "bklgtykj0n3n", "created_at": "2026-06-16T09:48:53.348Z", "updated_at": "2026-06-16T09:48:53.348Z", "display_at": "2026-06-16T09:48:53.348Z", "affected_components": [{"code": "v3rbxq0mztjx", "name": "Longview", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "1tv89m73r6pp", "status": "identified", "body": "The issue has been identified and a fix is being implemented.", "incident_id": "bklgtykj0n3n", "created_at": "2026-06-16T09:46:09.078Z", "updated_at": "2026-06-16T09:46:09.078Z", "display_at": "2026-06-16T09:46:09.078Z", "affected_components": [{"code": "v3rbxq0mztjx", "name": "Longview", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "n9ljlmw1d40c", "status": "investigating", "body": "Our team is investigating an issue affecting the Longview service. During this time, users may experience \"waiting for data\" in cloud manager and might not see the expected metrics.  We will share additional updates as we have more information.", "incident_id": "bklgtykj0n3n", "created_at": "2026-06-16T08:56:14.725Z", "updated_at": "2026-06-16T08:56:14.725Z", "display_at": "2026-06-16T08:56:14.725Z", "affected_components": [{"code": "v3rbxq0mztjx", "name": "Longview", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "v3rbxq0mztjx", "name": "Longview", "status": "operational", "created_at": "2018-11-19T20:19:30.287Z", "updated_at": "2026-06-16T13:13:59.949Z", "position": 4, "description": null, "showcase": false, "start_date": null, "group_id": null, "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "dgkwzzp45247", "name": "Emerging Service Issue - Linode Migrations", "status": "resolved", "created_at": "2026-06-16T03:44:25.474Z", "updated_at": "2026-06-16T06:06:44.171Z", "monitoring_at": "2026-06-16T05:14:28.562Z", "resolved_at": "2026-06-16T06:06:44.157Z", "impact": "none", "shortlink": "https://stspg.io/kxm1gxmkzs4x", "started_at": "2026-06-16T03:44:25.466Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "f0659tgvx5rf", "status": "resolved", "body": "The issue affecting Linode Migrations has been resolved. Resize and Migration operations should be operating as normal now.", "incident_id": "dgkwzzp45247", "created_at": "2026-06-16T06:06:44.157Z", "updated_at": "2026-06-16T06:06:44.157Z", "display_at": "2026-06-16T06:06:44.157Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "021m5ywd08n9", "status": "monitoring", "body": "A fix has been implemented and we are monitoring the results.", "incident_id": "dgkwzzp45247", "created_at": "2026-06-16T05:14:28.562Z", "updated_at": "2026-06-16T05:14:28.562Z", "display_at": "2026-06-16T05:14:28.562Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "cpdx3vdfsls5", "status": "identified", "body": "Our team is investigating an emerging service issue affecting Linode Migrations in all regions. Migrations might be slow or pending for long time. We will share additional updates as we have more information.", "incident_id": "dgkwzzp45247", "created_at": "2026-06-16T03:44:25.523Z", "updated_at": "2026-06-16T03:44:25.523Z", "display_at": "2026-06-16T03:44:25.523Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "cr2njwm3b5rc", "name": "Linode Community Maintenance", "status": "resolved", "created_at": "2026-06-02T01:26:10.199Z", "updated_at": "2026-06-08T19:35:30.679Z", "monitoring_at": "2026-06-08T17:59:31.000Z", "resolved_at": "2026-06-08T19:35:20.976Z", "impact": "maintenance", "shortlink": "https://stspg.io/pgm6glmcjtkn", "started_at": "2026-06-02T01:26:10.193Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "qh21dfr7r58h", "status": "resolved", "body": "We haven't observed any additional issues with the Community Site, and will now consider this incident resolved. If you are still experiencing additional issues, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "cr2njwm3b5rc", "created_at": "2026-06-08T19:35:20.976Z", "updated_at": "2026-06-08T19:35:20.976Z", "display_at": "2026-06-08T19:35:20.976Z", "affected_components": [{"code": "qx710vq78w73", "name": "Linode.com", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "mdwdmkcjts31", "status": "monitoring", "body": "At this time we have been able to correct the issue affecting connectivity to the Community Site. We will be monitoring this to ensure that connectivity remains stable. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "cr2njwm3b5rc", "created_at": "2026-06-08T17:59:31.974Z", "updated_at": "2026-06-08T19:35:30.667Z", "display_at": "2026-06-08T17:59:31.000Z", "affected_components": [{"code": "qx710vq78w73", "name": "Linode.com", "old_status": "under_maintenance", "new_status": "operational"}], "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "jl8tcp315xgt", "status": "identified", "body": "We are continuing to work on a fix for this issue.", "incident_id": "cr2njwm3b5rc", "created_at": "2026-06-02T01:33:01.636Z", "updated_at": "2026-06-02T01:33:01.636Z", "display_at": "2026-06-02T01:33:01.636Z", "affected_components": [{"code": "qx710vq78w73", "name": "Linode.com", "old_status": "under_maintenance", "new_status": "under_maintenance"}], "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "5wt8vm34pz4s", "status": "identified", "body": "Our team has identified issues with the Community Site (https://www.linode.com/community/questions/). During this time, the page has been moved under maintenance mode. We will share additional updates as we have more information.", "incident_id": "cr2njwm3b5rc", "created_at": "2026-06-02T01:26:10.285Z", "updated_at": "2026-06-02T01:26:10.285Z", "display_at": "2026-06-02T01:26:10.285Z", "affected_components": [{"code": "qx710vq78w73", "name": "Linode.com", "old_status": "operational", "new_status": "under_maintenance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "qx710vq78w73", "name": "Linode.com", "status": "operational", "created_at": "2018-09-12T17:50:34.088Z", "updated_at": "2026-08-28T12:48:25.559Z", "position": 1, "description": null, "showcase": false, "start_date": null, "group_id": null, "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "z3w92jxgs3gk", "name": "Emerging Service Issue - LKE Enterprise - All Regions", "status": "resolved", "c