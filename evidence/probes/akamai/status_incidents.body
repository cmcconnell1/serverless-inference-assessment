id": "cvnf1cpz83pb", "name": "AU-MEL (Melbourne) Block Storage", "status": "operational", "created_at": "2025-04-09T19:46:16.009Z", "updated_at": "2025-12-08T09:00:22.518Z", "position": 27, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "vblbdlkfj7tq", "name": "IN-BOM-2 (Mumbai 2) Block Storage", "status": "operational", "created_at": "2025-04-09T19:46:31.538Z", "updated_at": "2025-12-08T09:00:22.568Z", "position": 28, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "4s7dcn6gybm3", "name": "DE-FRA-2 (Frankfurt 2) Block Storage", "status": "operational", "created_at": "2025-04-09T19:46:59.626Z", "updated_at": "2025-12-08T09:00:22.613Z", "position": 29, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "t9w2bzmj1zln", "name": "SG-SIN-2 (Singapore 2) Block Storage", "status": "operational", "created_at": "2025-04-09T19:47:19.669Z", "updated_at": "2026-06-30T22:10:16.041Z", "position": 30, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "l9dmg37l7sx7", "name": "JP-TYO-3 (Tokyo 3) Block Storage", "status": "operational", "created_at": "2025-04-09T19:48:48.359Z", "updated_at": "2025-12-08T09:00:22.707Z", "position": 31, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "mrxy6gg8f4qw", "name": "Connectivity Issue - Linodes in Milan, Italy", "status": "postmortem", "created_at": "2026-07-20T01:52:05.576Z", "updated_at": "2026-07-20T06:01:49.083Z", "monitoring_at": "2026-07-20T03:20:12.902Z", "resolved_at": "2026-07-20T04:10:42.256Z", "impact": "minor", "shortlink": "https://stspg.io/5yjdn7bzqpk4", "started_at": "2026-07-20T01:52:05.564Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "001klqlcwrnb", "status": "postmortem", "body": "Starting around 00:33 UTC on July 20, 2026, some hosts in the Milan, Italy data center became unavailable, impacting customer access to Linodes. The investigation identified that this issue occurred during scheduled router firmware updates. While we follow a phased upgrade process to prevent service disruption, an unexpected intersection of concurrent maintenance activities led to a temporary loss of network connectivity for the affected hosts.   Service was fully restored by 02:16 UTC on July 20, 2026, and all systems are now operating as expected. Internally, we are reviewing our change management and maintenance scheduling procedures to ensure better coordination and prevent similar issues in the future.   We apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence.   This summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T05:45:18.079Z", "updated_at": "2026-07-20T06:01:49.070Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our July 20th incident: https://stspg.io/5yjdn7bzqpk4", "tweet_id": null}, {"id": "2wq9k2tgvvcq", "status": "resolved", "body": "We haven\u2019t observed any additional connectivity issues in our Milan (Italy) data center and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T04:10:42.256Z", "updated_at": "2026-07-20T04:10:42.256Z", "display_at": "2026-07-20T04:10:42.256Z", "affected_components": [{"code": "97ph0y1mr35s", "name": "Regions - IT-MIL (Milan)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "1ztzd6rsffmv", "status": "monitoring", "body": "At this time, we have been able to correct the issues affecting connectivity in our Milan (Italy) data center. We will be monitoring this to ensure that it remains stable. If you are still experiencing issues, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T03:20:12.902Z", "updated_at": "2026-07-20T03:20:12.902Z", "display_at": "2026-07-20T03:20:12.902Z", "affected_components": [{"code": "97ph0y1mr35s", "name": "Regions - IT-MIL (Milan)", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "lmz5blpf37gl", "status": "investigating", "body": "Our team has identified the issue affecting connectivity in our Milan (Italy) data center. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T03:12:24.622Z", "updated_at": "2026-07-20T03:12:24.622Z", "display_at": "2026-07-20T03:12:24.622Z", "affected_components": [{"code": "97ph0y1mr35s", "name": "Regions - IT-MIL (Milan)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "1jfb7z6qgwz1", "status": "investigating", "body": "We are continuing to investigate this issue. We will provide the next update as we make progress.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T02:56:19.350Z", "updated_at": "2026-07-20T02:56:19.350Z", "display_at": "2026-07-20T02:56:19.350Z", "affected_components": [{"code": "97ph0y1mr35s", "name": "Regions - IT-MIL (Milan)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "wyz6pgn6x4t4", "status": "investigating", "body": "Our team is currently investigating a connectivity issue affecting Linodes in the Italy (Milan) region. During this time, existing Linodes in this location may be unreachable. Please note that creating new Linodes is functioning normally and remains unaffected.", "incident_id": "mrxy6gg8f4qw", "created_at": "2026-07-20T01:52:05.679Z", "updated_at": "2026-07-20T01:52:05.679Z", "display_at": "2026-07-20T01:52:05.679Z", "affected_components": [{"code": "97ph0y1mr35s", "name": "Regions - IT-MIL (Milan)", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "97ph0y1mr35s", "name": "IT-MIL (Milan)", "status": "operational", "created_at": "2023-09-21T16:28:54.027Z", "updated_at": "2026-08-19T05:30:26.450Z", "position": 17, "description": null, "showcase": false, "start_date": "2023-09-21", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "jjrwrgsvs81d", "name": "Service Issue - Object Storage", "status": "postmortem", "created_at": "2026-07-18T03:34:19.397Z", "updated_at": "2026-07-21T15:26:51.042Z", "monitoring_at": null, "resolved_at": "2026-07-18T04:36:16.213Z", "impact": "minor", "shortlink": "https://stspg.io/h46fkksq1ct3", "started_at": "2026-07-18T03:34:19.377Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "yj284n51xh9j", "status": "postmortem", "body": "On July 18, 2026, between approximately 00:30 UTC and 04:00 UTC, users might have experienced 5xx errors while trying to create a new bucket in the Object Storage for the following endpoints.\n\n* [us-ord-1.linodeobjects.com](http://us-ord-1.linodeobjects.com)\n* [us-lax-1.linodeobjects.com](http://us-lax-1.linodeobjects.com)\n* [us-iad-1.linodeobjects.com](http://us-iad-1.linodeobjects.com)\n* [us-sea-1.linodeobjects.com](http://us-sea-1.linodeobjects.com)\n* [fr-par-1.linodeobjects.com](http://fr-par-1.linodeobjects.com)\n\n\u200cThe issue began when the infrastructure supporting Object Storage entered a degraded state across all nodes. This prevented the service from processing requests, resulting in failures during bucket creation operations.\n\n\u200cTo mitigate the impact, we have applied a fix at the backend system responsible for bucket creation. The impact was mitigated following this action.\n\n\u200cOur subject matter experts are investigating the root cause and will take appropriate preventive actions.\n\n\u200cWe apologize for the impact and appreciate your patience and ongoing support. We are making configuration and operational changes to our systems to help prevent this from happening again, and remain committed to continuous improvement.\n\n\u200cThis summary provides an overview of our current understanding of the incident, given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "jjrwrgsvs81d", "created_at": "2026-07-21T15:26:12.836Z", "updated_at": "2026-07-21T15:26:51.039Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our July 18th incident: https://stspg.io/h46fkksq1ct3", "tweet_id": null}, {"id": "l8wrxjgjgwlb", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Object Storage service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "jjrwrgsvs81d", "created_at": "2026-07-18T04:36:16.213Z", "updated_at": "2026-07-18T04:36:16.213Z", "display_at": "2026-07-18T04:36:16.213Z", "affected_components": [{"code": "10t1r7ynvgrt", "name": "Object Storage - US-IAD (Washington) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "ck38k99lvyfx", "name": "Object Storage - US-ORD (Chicago) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "lymkxx3dqrzg", "name": "Object Storage - FR-PAR (Paris) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "gvjkvq1qzfhf", "name": "Object Storage - US-SEA (Seattle) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "twt8xm9nk710", "name": "Object Storage - US-LAX (Los Angeles) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "8kffhgz1ysb6", "status": "identified", "body": "Our team has identified the issue affecting the Object Storage service. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "jjrwrgsvs81d", "created_at": "2026-07-18T03:54:02.423Z", "updated_at": "2026-07-18T03:54:02.423Z", "display_at": "2026-07-18T03:54:02.423Z", "affected_components": [{"code": "10t1r7ynvgrt", "name": "Object Storage - US-IAD (Washington) Object Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "ck38k99lvyfx", "name": "Object Storage - US-ORD (Chicago) Object Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "lymkxx3dqrzg", "name": "Object Storage - FR-PAR (Paris) Object Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "gvjkvq1qzfhf", "name": "Object Storage - US-SEA (Seattle) Object Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "twt8xm9nk710", "name": "Object Storage - US-LAX (Los Angeles) Object Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "pqj6zdvbf14t", "status": "investigating", "body": "Our team is investigating an issue affecting the Object Storage service. During this time, users may experience connection timeouts and errors with this service.", "incident_id": "jjrwrgsvs81d", "created_at": "2026-07-18T03:34:19.593Z", "updated_at": "2026-07-18T03:34:19.593Z", "display_at": "2026-07-18T03:34:19.593Z", "affected_components": [{"code": "10t1r7ynvgrt", "name": "Object Storage - US-IAD (Washington) Object Storage", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "ck38k99lvyfx", "name": "Object Storage - US-ORD (Chicago) Object Storage", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "lymkxx3dqrzg", "name": "Object Storage - FR-PAR (Paris) Object Storage", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "gvjkvq1qzfhf", "name": "Object Storage - US-SEA (Seattle) Object Storage", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "twt8xm9nk710", "name": "Object Storage - US-LAX (Los Angeles) Object Storage", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "10t1r7ynvgrt", "name": "US-IAD (Washington) Object Storage", "status": "operational", "created_at": "2023-07-05T17:52:55.404Z", "updated_at": "2026-07-18T04:36:16.072Z", "position": 3, "description": null, "showcase": false, "start_date": "2023-07-05", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "ck38k99lvyfx", "name": "US-ORD (Chicago) Object Storage", "status": "operational", "created_at": "2023-07-05T17:57:38.881Z", "updated_at": "2026-07-18T04:36:16.097Z", "position": 4, "description": null, "showcase": false, "start_date": "2023-07-05", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "lymkxx3dqrzg", "name": "FR-PAR (Paris) Object Storage", "status": "operational", "created_at": "2023-07-05T17:54:58.624Z", "updated_at": "2026-07-18T04:36:16.121Z", "position": 7, "description": null, "showcase": false, "start_date": "2023-07-05", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "gvjkvq1qzfhf", "name": "US-SEA (Seattle) Object Storage", "status": "operational", "created_at": "2023-09-18T18:26:48.687Z", "updated_at": "2026-07-18T04:36:16.144Z", "position": 9, "description": null, "showcase": false, "start_date": "2023-09-18", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "twt8xm9nk710", "name": "US-LAX (Los Angeles) Object Storage", "status": "operational", "created_at": "2025-04-14T16:40:28.708Z", "updated_at": "2026-07-18T04:36:16.166Z", "position": 22, "description": null, "showcase": false, "start_date": "2025-04-14", "group_id": "4bvp5l14grs6", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "hvk9d7fqd5d5", "name": "Connectivity Issue - US-MIA (Miami", "status": "resolved", "created_at": "2026-07-16T01:24:41.719Z", "updated_at": "2026-07-16T01:24:41.792Z", "monitoring_at": null, "resolved_at": "2026-07-16T01:24:41.783Z", "impact": "none", "shortlink": "https://stspg.io/1t3jkqj5kfy3", "started_at": "2026-07-16T01:24:41.712Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "b627f817f3qm", "status": "resolved", "body": "Our team investigated an issue that affected connectivity in our US-MIA (Miami) data center between 21:20 UTC and approximately 23:28 UTC on July 15, 2026. During this window, users may have experienced degraded networking performance and packet loss for Compute services deployed in this region.\n\n The issue was resolved after we implemented a fix. We are continuing to work with our third-party service provider to confirm the root cause, as initial evidence points to a campus cross-connect (dark fiber) outage on their infrastructure.", "incident_id": "hvk9d7fqd5d5", "created_at": "2026-07-16T01:24:41.783Z", "updated_at": "2026-07-16T01:24:41.783Z", "display_at": "2026-07-16T01:24:41.783Z", "affected_components": [{"code": "pkd875v4jmzl", "name": "Regions - US-MIA (Miami)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "pkd875v4jmzl", "name": "US-MIA (Miami)", "status": "operational", "created_at": "2023-10-16T15:27:22.335Z", "updated_at": "2026-08-19T05:30:31.032Z", "position": 23, "description": null, "showcase": false, "start_date": "2023-10-16", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "hrw033kskwbh", "name": "Service Issue - Linode API/CLI", "status": "postmortem", "created_at": "2026-07-14T12:21:18.341Z", "updated_at": "2026-07-16T18:13:45.069Z", "monitoring_at": "2026-07-14T13:11:43.923Z", "resolved_at": "2026-07-14T19:26:42.772Z", "impact": "minor", "shortlink": "https://stspg.io/sdbw18qx96mh", "started_at": "2026-07-14T12:21:18.275Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "49k8p4vzbn26", "status": "postmortem", "body": "On July 14, 2026, at 10:57 UTC, Akamai identified an increase in 502 errors and latency affecting customers using the Linode API, CLI, and Cloud Manager. This disruption resulted in moderate service impact, with customers reporting elevated error rates. Our initial investigation traced the issue to latency with IAM services, which was resolved, but elevated errors persisted.\u00a0\n\nFurther analysis by relevant subject matter experts determined that the incident was triggered by a manual failback to the Cloud IAM primary load balancer from the secondary load balancer. This action was prompted by a warning alert indicating that the secondary load balancer was acting as the keepalived master. The manual process of starting and stopping services to initiate the failback differed from the automated process and led to a cascade of stale GRPC connections, causing increased latency and API errors. Restarting the API servers cleared the stale connections and restored normal operations. Customer impact was mitigated by approximately 13:10 UTC on July 14, 2026.\n\nTo prevent recurrence, Akamai is investigating why the manual failback caused this behavior. The team is considering implementing a drain command to clear GRPC connections during failover and setting up alerts to detect stale connections for proactive intervention. However, the immediate focus remains on understanding the root cause, with alerting and automation planned for later phases.\n\nSeveral customers have confirmed resolution across their deployments. Akamai will continue to monitor system health and await additional customer feedback before declaring full recovery.\u00a0\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-16T18:13:13.839Z", "updated_at": "2026-07-16T18:13:45.066Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our July 14th incident: https://stspg.io/sdbw18qx96mh", "tweet_id": null}, {"id": "v9c56688gc1x", "status": "resolved", "body": "We haven't observed any additional issues with the Cloud Manager, API, or CLI, and will now consider this incident resolved. If you continue to experience issues, please contact us at 855-454-6633 (+1-609-380-7100 Intl.), or send an email to support@linode.com for assistance.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T19:26:42.772Z", "updated_at": "2026-07-14T19:26:42.772Z", "display_at": "2026-07-14T19:26:42.772Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "jdws8gcl1kxj", "status": "monitoring", "body": "We are continuing to monitor for any further issues.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T18:36:04.903Z", "updated_at": "2026-07-14T18:36:04.903Z", "display_at": "2026-07-14T18:36:04.903Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "d6nb256fbtbj", "status": "monitoring", "body": "We are continuing to monitor for any further issues.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T16:06:20.956Z", "updated_at": "2026-07-14T16:06:20.956Z", "display_at": "2026-07-14T16:06:20.956Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "yg9tq891fmny", "status": "monitoring", "body": "At this time we have been able to correct the issue affecting the Cloud Manager and API. We will be monitoring this to ensure that the service remains stable. If you are still experiencing issues and unable to <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a>, please call us at 855-454-6633 (+1-609-380-7100 Intl.), or send an email to support@linode.com.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T13:11:43.923Z", "updated_at": "2026-07-14T13:11:43.923Z", "display_at": "2026-07-14T13:11:43.923Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "wsszh4mfmw2z", "status": "identified", "body": "Our team has identified the issue affecting the Cloud Manager and API. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T12:58:20.041Z", "updated_at": "2026-07-14T12:58:20.041Z", "display_at": "2026-07-14T12:58:20.041Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "z8944gv6wfsn", "status": "investigating", "body": "Our team is investigating an emerging service issue affecting the API and CLI. We will share additional updates as we have more information.", "incident_id": "hrw033kskwbh", "created_at": "2026-07-14T12:21:18.531Z", "updated_at": "2026-07-14T12:21:18.531Z", "display_at": "2026-07-14T12:21:18.531Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "v8zpnn61fcdm", "name": "Regions - US-East (Newark)", "old_status": "operational", "new_status": "operational"}, {"code": "s8355f9s5hpx", "name": "Regions - US-Central (Dallas)", "old_status": "operational", "new_status": "operational"}, {"code": "v5mcdxdt9dtv", "name": "Regions - US-West (Fremont)", "old_status": "operational", "new_status": "operational"}, {"code": "ss2n92gy5xkk", "name": "Regions - US-Southeast (Atlanta)