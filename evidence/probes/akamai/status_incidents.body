start_date": "2023-07-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "5lw6b06mjfww", "name": "US-SEA (Seattle)", "status": "operational", "created_at": "2023-09-18T18:24:26.265Z", "updated_at": "2026-08-28T12:48:25.580Z", "position": 16, "description": null, "showcase": false, "start_date": "2023-09-18", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "k0thr1zd6smm", "name": "IN-MAA (Chennai)", "status": "operational", "created_at": "2023-10-02T18:06:22.477Z", "updated_at": "2026-08-19T05:30:27.824Z", "position": 19, "description": null, "showcase": false, "start_date": "2023-10-02", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "pkd875v4jmzl", "name": "US-MIA (Miami)", "status": "operational", "created_at": "2023-10-16T15:27:22.335Z", "updated_at": "2026-08-19T05:30:31.032Z", "position": 23, "description": null, "showcase": false, "start_date": "2023-10-16", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "7xrbxwctvj1h", "name": "US-LAX (Los Angeles)", "status": "operational", "created_at": "2023-10-25T16:18:15.347Z", "updated_at": "2026-08-19T05:30:31.772Z", "position": 24, "description": null, "showcase": false, "start_date": "2023-10-25", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "8xrfbhs3qrxq", "name": "IN-BOM-2 (Mumbai 2)", "status": "operational", "created_at": "2024-09-26T14:39:31.908Z", "updated_at": "2026-08-19T05:30:35.221Z", "position": 28, "description": null, "showcase": false, "start_date": "2024-09-26", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "2vzdgh6ysfzz", "name": "US-DEN (Denver)", "status": "operational", "created_at": "2025-04-08T13:39:37.373Z", "updated_at": "2026-08-19T05:30:42.016Z", "position": 35, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "4j2hqzkcb5bw", "name": "US-HOU (Houston)", "status": "operational", "created_at": "2025-04-08T13:41:51.324Z", "updated_at": "2026-08-19T05:30:43.574Z", "position": 37, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "x1293sz7zyff", "name": "US-IAD-2 (Washington 2)", "status": "operational", "created_at": "2026-05-05T19:15:39.919Z", "updated_at": "2026-08-19T05:30:49.359Z", "position": 43, "description": null, "showcase": false, "start_date": "2026-05-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "s9q96vkhd4y3", "name": "Service Issue - Host Job Performance Degradation - Several Regions", "status": "postmortem", "created_at": "2026-07-28T18:14:08.047Z", "updated_at": "2026-07-31T18:57:49.432Z", "monitoring_at": "2026-07-28T22:51:14.503Z", "resolved_at": "2026-07-29T12:27:16.244Z", "impact": "none", "shortlink": "https://stspg.io/s1gh58v1nl6s", "started_at": "2026-07-28T18:14:08.000Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "9vr6gr9ygzvr", "status": "postmortem", "body": "On 27 July 2026 at 3:30 UTC, Akamai observed an increase in errors when connecting to the Linode hosting database, primarily affecting Block Storage volume attachments. This resulted in host job failures and limited customer impact, with some users experiencing error messages and interrupted workflows. Elevated timeout rates were noted in logs for certain data center locations, coinciding with the incremental rollout of a new feature flag.\n\nInitial investigation revealed intermittent packet drops from the database proxy to client hosts during the TLS handshake. The current theory suggests that a DDoS-protection limit related to path MTU packet too big ICMP messages was reached. When the proxy sent TCP packets with a large MTU, the expected ICMP messages were dropped by Dallas gateway routers due to exceeding the configured allowable rate. This caused database proxy TCP connections to timeout to Compute Hosts. The issue was triggered by the enablement of the new feature flag, which changed the routing path and removed MTU clamping before packets reached the gateways.\n\nTo mitigate the issue, Akamai rolled back the recent network change across affected Compute sites, starting at 20:50 UTC. As of 22:57 UTC, the rate of service restarts returned to pre-incident levels. Akamai is also planning a change to increase the allowable threshold for packet too big ICMP messages.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "s9q96vkhd4y3", "created_at": "2026-07-31T18:57:30.722Z", "updated_at": "2026-07-31T18:57:49.429Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our July 28th incident: https://stspg.io/s1gh58v1nl6s", "tweet_id": null}, {"id": "3m3gq8p0d9rv", "status": "resolved", "body": "We haven\u2019t observed any additional host jobs performance degradation issues, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "s9q96vkhd4y3", "created_at": "2026-07-29T12:27:16.244Z", "updated_at": "2026-07-29T12:27:16.244Z", "display_at": "2026-07-29T12:27:16.244Z", "affected_components": [{"code": "zq4h2zstlwhz", "name": "Block Storage - US-East (Newark) Block Storage", "old_status": "operational", "new_status": "