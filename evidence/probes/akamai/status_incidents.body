74Z", "position": 37, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "z8lp5jw3mjpb", "name": "MY-KUL (Kuala Lumpur)", "status": "operational", "created_at": "2025-04-08T13:42:25.784Z", "updated_at": "2026-08-19T05:30:44.821Z", "position": 38, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "qks0rqykcp34", "name": "FR-MRS (Marseille)", "status": "operational", "created_at": "2025-04-08T13:43:42.266Z", "updated_at": "2026-08-19T05:30:45.455Z", "position": 39, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "kzl6jczkb2tk", "name": "MX-QRO (Queretaro)", "status": "operational", "created_at": "2025-04-08T13:44:50.559Z", "updated_at": "2026-08-19T05:30:46.696Z", "position": 40, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "3rsd4fh24z48", "name": "CL-SCL (Santiago)", "status": "operational", "created_at": "2025-04-08T13:45:05.933Z", "updated_at": "2026-08-19T05:30:47.679Z", "position": 41, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "gbwj4lm4196m", "name": "FR-PAR-2 (Paris 2)", "status": "operational", "created_at": "2026-01-06T15:34:24.715Z", "updated_at": "2026-08-19T05:30:48.666Z", "position": 42, "description": null, "showcase": false, "start_date": "2026-01-06", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "dlkgl9zjql44", "name": "Service Issue - Connectivity Issues - Chennai (IN-MAA)", "status": "postmortem", "created_at": "2026-04-28T17:17:58.039Z", "updated_at": "2026-05-06T19:33:54.093Z", "monitoring_at": null, "resolved_at": "2026-05-04T03:43:08.518Z", "impact": "minor", "shortlink": "https://stspg.io/6g9f4gysldrm", "started_at": "2026-04-28T17:17:58.031Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "nyncrcqngllk", "status": "postmortem", "body": "At approximately 3:30 UTC on April 28, 2026, we experienced a router failure in our Chennai data center, which, when paired with a separate network hardware component temporarily operating at a reduced capacity, resulted in intermittent delays or timeouts for Compute customers accessing Linodes and other resources in the Chennai \\(MAA\\) region during peak traffic hours \\(~09:00UTC - 18:00UTC\\) on April 28, 2026.\n\nAt 11:40UTC on April 29, 2026, we unthrottled the constrained network component, resulting in enough regional capacity to effectively mitigate the risk for reoccurrence of customer impact during peak regional traffic hours going forward.\n\nAt 12:11 UTC on May 2, 2026, we successfully replaced the degraded router and brought the new router online, restoring full capacity to the region.\n\nWe will work with our hardware vendor partner to understand the failure mode of the router and ensure any potential preventative actions are noted and taken proactively.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "dlkgl9zjql44", "created_at": "2026-05-06T18:49:33.745Z", "updated_at": "2026-05-06T19:33:54.091Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our April 28th incident: https://stspg.io/6g9f4gysldrm", "tweet_id": null}, {"id": "vfzz2vzw52ld", "status": "resolved", "body": "The network component has been replaced. The incident is now resolved.", "incident_id": "dlkgl9zjql44", "created_at": "2026-05-04T03:43:08.518Z", "updated_at": "2026-05-04T03:43:08.518Z", "display_at": "2026-05-04T03:43:08.518Z", "affected_components": [{"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "v55tqmyg2g0x", "status": "identified", "body": "We were able to identify a solution which resulted in additional capacity for the Chennai, IN region and did not experience any degradation over the peak hours on April 29, 2026, we anticipate this to be the case going forward, but will continue providing updates until we successfully replace the impacted network component. The replacement of the network component has been briefly delayed. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "dlkgl9zjql44", "created_at": "2026-04-29T22:13:02.281Z", "updated_at": "2026-04-29T22:13:02.281Z", "display_at": "2026-04-29T22:13:02.281Z", "affected_components": [{"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "ty3h0c36hnjw", "status": "identified", "body": "Our team has identified the issue affecting connectivity in our Chennai (IN-MAA) data center as a degraded network component and are working to expedite replacement as quickly as possible. At this time there is no customer impact, but due to lessened capacity as a result of this hardware degradation, we do expect intermittent delays or timeouts during peak traffic hours in the Chennai (IN-MAA) region. The current ETA for replacing this hardware is end of day on April 29, 2026. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "dlkgl9zjql44", "created_at": "2026-04-28T21:35:46.734Z", "updated_at": "2026-04-28T21:35:46.734Z", "display_at": "2026-04-28T21:35:46.734Z", "affected_components": [{"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "6yvfb5pz58w6", "status": "identified", "body": "Our team is investigating an emerging service issue affecting the network and connectivity in our Chennai (IN-MAA) data center. Customers may see intermittent delays and timeouts during peak traffic hours in the region.\n\nIf you are seeing impact that may be related, please <a href=\"https://cloud.linode.com/support/tickets?dialogOpen=true\">open a Support Ticket</a>.", "incident_id": "dlkgl9zjql44", "created_at": "2026-04-28T17:17:58.115Z", "updated_at": "2026-04-28T17:17:58.115Z", "display_at": "2026-04-28T17:17:58.115Z", "affected_components": [{"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "k0thr1zd6smm", "name": "IN-MAA (Chennai)", "status": "operational", "created_at": "2023-10-02T18:06:22.477Z", "updated_at": "2026-08-19T05:30:27.824Z", "position": 19, "description": null, "showcase": false, "start_date": "2023-10-02", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "2466t3hw700h", "name": "Object Storage Key creation and validation failing with error 403 in multiple data centers", "status": "postmortem", "created_at": "2026-04-29T09:22:02.620Z", "updated_at": "2026-04-30T13:06:28.590Z", "monitoring_at": null, "resolved_at": "2026-04-29T19:19:35.976Z", "impact": "minor", "shortlink": "https://stspg.io/6l0lwbllbvdp", "started_at": "2026-04-29T09:22:02.581Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "fwtw06gkg91t", "status": "postmortem", "body": "Between approximately 09:15 UTC on April 28, 2026 and 16:54 UTC on April 29, 2026 customers could have experienced issues with their Object Storage key pairs, including: key creation and validation, Object Storage access with their keys. The impact was seen throughout multiple data centers.\n\nOur investigation established that the issue started due to a combination of factors, including: a cascading failure of a background process from one cluster to others and a reconciler appliance not running due to missing metrics and an abnormal system load that led to call failures.\n\nTo resolve the issue, we have restarted the reconciler and key operations were processed for customers.\n\nTo help prevent similar issues in the future, Akamai will address the cascading failure scenario, add reconciler metrics to prevent the type of outage seen as well enhance queue management to improve reconciler performance.\n\nWe apologize for the impact and thank you for your patience and continued support. We are committed to making continuous improvements to make our systems better and prevent recurrence.\n\nThis summary provides an overview of our current understanding of the incident, given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "2466t3hw700h", "created_at": "2026-04-30T13:05:41.296Z", "updated_at": "2026-04-30T13:06:28.587Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our April 29th incident: https://stspg.io/6l0lwbllbvdp", "tweet_id": null}, {"id": "70qn15yx59zw", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Object Storage service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "2466t3hw700h", "created_at": "2026-04-29T19:19:35.976Z", "updated_at": "2026-04-29T19:19:35.976Z", "display_at": "2026-04-29T19:19:35.976Z", "affected_components": [{"code": "q55c1gfpf7m4", "name": "Object Storage - US-East (Newark) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "y5gcmn9bstbg", "name": "Object Storage - US-Southeast (Atlanta) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "10t1r7ynvgrt", "name": "Object Storage - US-IAD (Washington) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "ck38k99lvyfx", "name": "Object Storage - US-ORD (Chicago) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "zm7300chzddp", "name": "Object Storage - EU-Central (Frankfurt) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "l8y4k4tz708b", "name": "Object Storage - AP-South (Singapore) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "lymkxx3dqrzg", "name": "Object Storage - FR-PAR (Paris) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "d8lw3dgj3yh0", "name": "Object Storage - SE-STO (Stockholm) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "gvjkvq1qzfhf", "name": "Object Storage - US-SEA (Seattle) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "mmcbvhbgszgt", "name": "Object Storage - JP-OSA (Osaka) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "98j4pgtnvxnp", "name": "Object Storage - IN-MAA (Chennai) Object Storage", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "258cxgptftx8", "name": "Obje