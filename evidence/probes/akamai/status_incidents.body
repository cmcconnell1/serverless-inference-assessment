_status": "operational"}, {"code": "4j2hqzkcb5bw", "name": "Regions - US-HOU (Houston)", "old_status": "operational", "new_status": "operational"}, {"code": "z8lp5jw3mjpb", "name": "Regions - MY-KUL (Kuala Lumpur)", "old_status": "operational", "new_status": "operational"}, {"code": "qks0rqykcp34", "name": "Regions - FR-MRS (Marseille)", "old_status": "operational", "new_status": "operational"}, {"code": "kzl6jczkb2tk", "name": "Regions - MX-QRO (Queretaro)", "old_status": "operational", "new_status": "operational"}, {"code": "3rsd4fh24z48", "name": "Regions - CL-SCL (Santiago)", "old_status": "operational", "new_status": "operational"}, {"code": "gbwj4lm4196m", "name": "Regions - FR-PAR-2 (Paris 2)", "old_status": "operational", "new_status": "operational"}, {"code": "x1293sz7zyff", "name": "Regions - US-IAD-2 (Washington 2)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "61mfhwczrxzt", "name": "Cloud Manager and API", "status": "operational", "created_at": "2014-03-13T15:38:54.572Z", "updated_at": "2026-09-25T16:21:50.057Z", "position": 2, "description": null, "showcase": false, "start_date": null, "group_id": null, "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "70n3myfk1kjd", "name": "Service Issue - Host Jobs - All Regions", "status": "resolved", "created_at": "2026-07-13T18:29:50.195Z", "updated_at": "2026-07-14T15:35:08.761Z", "monitoring_at": null, "resolved_at": "2026-07-13T19:54:44.393Z", "impact": "none", "shortlink": "https://stspg.io/gzwcz2cg3zf7", "started_at": "2026-07-13T18:29:50.189Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "0r5ss6jkh13p", "status": "resolved", "body": "This incident has been resolved.", "incident_id": "70n3myfk1kjd", "created_at": "2026-07-13T19:54:44.393Z", "updated_at": "2026-07-13T19:54:44.393Z", "display_at": "2026-07-13T19:54:44.393Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "896rynf52hs7", "status": "identified", "body": "Our team has identified an emerging service issue affecting host jobs for some hosts across all regions. Linode connectivity is *not impacted*, but some host-level jobs, such as backups or attempts to power on or off your services may be delayed. We will share additional updates as we have more information.", "incident_id": "70n3myfk1kjd", "created_at": "2026-07-13T18:29:50.240Z", "updated_at": "2026-07-13T18:29:50.240Z", "display_at": "2026-07-13T18:29:50.240Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "g7x2ys539382", "name": "Emerging Service Issue - Cloud Manager", "status": "postmortem", "created_at": "2026-07-09T16:57:56.705Z", "updated_at": "2026-07-10T12:31:19.387Z", "monitoring_at": "2026-07-09T17:49:42.578Z", "resolved_at": "2026-07-09T18:21:03.135Z", "impact": "none", "shortlink": "https://stspg.io/940qf1lq7g1n", "started_at": "2026-07-09T16:57:56.699Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "1d8jf1vctsh4", "status": "postmortem", "body": "On July 9, 2026, at 15:43 UTC, customers were unable to login to [cloud.linode.com](http://cloud.linode.com) using username and password. Customers were getting \"wrong password\" error message.\u00a0\n\nInvestigation revealed that the issue was due to an internal certificate issue.\n\nTo mitigate the impact, we fixed the certificate issue on the impacted servers at 17:24 UTC on July 9, 2026. After monitoring our systems for some time, we confirmed the issue was fully resolved.\n\nAkamai will deploy a permanent fix to prevent a recurrence of the issue.", "incident_id": "g7x2ys539382", "created_at": "2026-07-10T12:30:26.237Z", "updated_at": "2026-07-10T12:31:19.384Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our July 9th incident: https://stspg.io/940qf1lq7g1n", "tweet_id": null}, {"id": "n8mrhc141ywc", "status": "resolved", "body": "We haven't observed any additional issues with the Cloud Manager logins and will now consider this incident resolved. If you continue to experience issues, please contact us at 855-454-6633 (+1-609-380-7100 Intl.), or send an email to support@linode.com for assistance.", "incident_id": "g7x2ys539382", "created_at": "2026-07-09T18:21:03.135Z", "updated_at": "2026-07-09T18:21:03.135Z", "display_at": "2026-07-09T18:21:03.135Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "jn2lkkjtsft9", "status": "monitoring", "body": "At this time we have been able to correct the issue affecting the  Cloud Manager logins. We will be monitoring this to ensure that the service remains stable. If you are still experiencing issues and unable to <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a>, please call us at 855-454-6633 (+1-609-380-7100 Intl.), or send an email to support@linode.com.", "incident_id": "g7x2ys539382", "created_at": "2026-07-09T17:49:42.578Z", "updated_at": "2026-07-09T17:49:42.578Z", "display_at": "2026-07-09T17:49:42.578Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "4kklf9hf2m5f", "status": "investigating", "body": "We are continuing to investigate this issue. We will provide an update within the next 30 minutes.", "incident_id": "g7x2ys539382", "created_at": "2026-07-09T17:24:20.665Z", "updated_at": "2026-07-09T17:24:20.665Z", "display_at": "2026-07-09T17:24:20.665Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "wyv7jrckywbc", "status": "investigating", "body": "Our team is investigating an emerging service issue affecting Cloud Manager logins. We will share additional updates as we have more information.", "incident_id": "g7x2ys539382", "created_at": "2026-07-09T16:57:56.773Z", "updated_at": "2026-07-09T16:57:56.773Z", "display_at": "2026-07-09T16:57:56.773Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "61mfhwczrxzt", "name": "Cloud Manager and API", "status": "operational", "created_at": "2014-03-13T15:38:54.572Z", "updated_at": "2026-09-25T16:21:50.057Z", "position": 2, "description": null, "showcase": false, "start_date": null, "group_id": null, "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "7xwnkwpc3038", "name": "Service Issue - ACLP Metrics", "status": "resolved", "created_at": "2026-06-26T17:35:04.000Z", "updated_at": "2026-07-08T12:26:09.472Z", "monitoring_at": "2026-06-26T21:13:31.075Z", "resolved_at": "2026-07-08T12:26:09.457Z", "impact": "minor", "shortlink": "https://stspg.io/vclyqyzwb4yj", "started_at": "2026-06-26T17:35:04.000Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "rzm19dqhrznk", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Cloud Pulse Metrics (ACLP Metrics) service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "7xwnkwpc3038", "created_at": "2026-07-08T12:26:09.457Z", "updated_at": "2026-07-08T12:26:09.457Z",