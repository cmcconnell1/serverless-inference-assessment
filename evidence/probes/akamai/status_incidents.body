"reminder_intervals": null}, {"id": "86grbml1l2wy", "name": "Service Issue - Linode Automated Networking", "status": "resolved", "created_at": "2026-07-01T17:21:49.261Z", "updated_at": "2026-07-01T18:28:17.547Z", "monitoring_at": "2026-07-01T18:09:40.101Z", "resolved_at": "2026-07-01T18:28:17.529Z", "impact": "none", "shortlink": "https://stspg.io/d4c83g4fqjln", "started_at": "2026-07-01T17:21:49.254Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "n04vlwkv30wl", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Linode Automated Networking service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "86grbml1l2wy", "created_at": "2026-07-01T18:28:17.529Z", "updated_at": "2026-07-01T18:28:17.529Z", "display_at": "2026-07-01T18:28:17.529Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "st2k1r7qvb0t", "status": "monitoring", "body": "A fix has been implemented to resolve the automated network configuration issue on Linodes using Network Helper. We recommend rebooting your Linode to restore full network functionality. We are actively monitoring the results to ensure continued stability.", "incident_id": "86grbml1l2wy", "created_at": "2026-07-01T18:09:40.101Z", "updated_at": "2026-07-01T18:09:40.101Z", "display_at": "2026-07-01T18:09:40.101Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "xyqxsstnjfzq", "status": "identified", "body": "Our team is investigating a service issue that affects the auto configuration of networking on Linodes by Network Helper to fail. During that time, some users may have Linodes provision but appear to have no connectivity. This also can impact Linodes created by the Linode Kubernetes Engine and impact autoscaling or provisioning of clusters. Customers can still manually configure networking via the LISH console to mitigate this issue. Please see our guide on <a href=\"https://techdocs.akamai.com/cloud-computing/docs/manual-network-configuration-on-a-compute-instance\">manual network configuration on a Compute Instance</a>.\n\nWe will share additional updates as we have more information.", "incident_id": "86grbml1l2wy", "created_at": "2026-07-01T17:21:49.314Z", "updated_at": "2026-07-01T17:21:49.314Z", "display_at": "2026-07-01T17:21:49.314Z", "affected_components": [{"code": "61mfhwczrxzt", "name": "Cloud Manager and API", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "61mfhwczrxzt", "name": "Cloud Manager and API", "status": "operational", "created_at": "2014-03-13T15:38:54.572Z", "updated_at": "2026-09-25T16:21:50.057Z", "position": 2, "description": null, "showcase": false, "start_date": null, "group_id": null, "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "48898jhjk4cz", "name": "Service Issue - Block Storage - Singapore Expansion, SP (sg-sin-2)", "status": "postmortem", "created_at": "2026-06-30T18:54:16.380Z", "updated_at": "2026-07-02T16:29:34.347Z", "monitoring_at": "2026-06-30T22:10:16.084Z", "resolved_at": "2026-06-30T23:22:07.070Z", "impact": "minor", "shortlink": "https://stspg.io/xrqbzpswmydd", "started_at": "2026-06-30T18:54:16.371Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "918mlybn80cn", "status": "postmortem", "body": "On June 30, 2026, between approximately 17:30 UTC and 21:45 UTC, users may have experienced connection timeouts and errors related to the Block Storage service in Singapore Expansion, SP \\(sg-sin-2\\).\n\nThe issue began when one host in the cluster was taken down for maintenance while another host unexpectedly encountered network issues. A configuration issue also contributed to the impact. These factors led to a degraded state that affected performance and, to a limited extent, data availability. We mitigated the impact to customers at 21:45 UTC on June 30, 2026 by correcting the network, configuration and cluster issues.\n\nWe apologize for the impact and appreciate your patience and ongoing support. We are making configuration and operational changes to our systems to help prevent this from happening again, and remain committed to continuous improvement.\n\nThis summary provides an overview of our current understanding of the incident, given the information available. Our investigation is ongoing, and any information herein is subject to change.", "incident_id": "48898jhjk4cz", "created_at": "2026-07-02T16:29:13.093Z", "updated_at": "2026-07-02T16:29:34.345Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 30th incident: https://stspg.io/xrqbzpswmydd", "tweet_id": null}, {"id": "77vv6v93q8d6", "status": "resolved", "body": "We haven\u2019t observed any additional issues with the Block Storage service in Singapore Expansion, SP (sg-sin-2), and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T23:22:07.070Z", "updated_at": "2026-06-30T23:22:07.070Z", "display_at": "2026-06-30T23:22:07.070Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "4k2rh3c0ly62", "status": "monitoring", "body": "At this time we have been able to correct the issues affecting the Block Storage service. We will be monitoring this to ensure that it remains stable. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T22:10:16.084Z", "updated_at": "2026-06-30T22:10:16.084Z", "display_at": "2026-06-30T22:10:16.084Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "2bbljx5d101c", "status": "identified", "body": "We are continuing to work on a fix for this issue.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T21:36:41.104Z", "updated_at": "2026-06-30T21:36:41.104Z", "display_at": "2026-06-30T21:36:41.104Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "v7g8p88vr0v4", "status": "identified", "body": "Our team has identified the issue affecting the  Block Storage service in our Singapore Expansion, SP (sg-sin-2) data center. We are working quickly to implement a fix, and we will provide an update as soon as the solution is in place.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T20:36:41.989Z", "updated_at": "2026-06-30T20:36:41.989Z", "display_at": "2026-06-30T20:36:41.989Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "l8r5trvhz693", "status": "investigating", "body": "We are continuing to investigate this issue.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T19:55:01.092Z", "updated_at": "2026-06-30T19:55:01.092Z", "display_at": "2026-06-30T19:55:01.092Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "m7smxklshkmt", "status": "investigating", "body": "Our team is investigating an emerging issue affecting the Block Storage service in our Singapore Expansion, SP (sg-sin-2) data center. During this time, users may experience connection timeouts and errors with this service. We will share additional updates as we have more information.", "incident_id": "48898jhjk4cz", "created_at": "2026-06-30T18:54:16.473Z", "updated_at": "2026-06-30T18:54:16.473Z", "display_at": "2026-06-30T18:54:16.473Z", "affected_components": [{"code": "t9w2bzmj1zln", "name": "Block Storage - SG-SIN-2 (Singapore 2) Block Storage", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "t9w2bzmj1zln", "name": "SG-SIN-2 (Singapore 2) Block Storage", "status": "operational", "created_at": "2025-04-09T19:47:19.669Z", "updated_at": "2026-06-30T22:10:16.041Z", "position": 30, "description": null, "showcase": false, "start_date": "2025-04-09", "group_id": "m5wrr6m00mvh", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "q3x20njn3xlm", "name": "Connectivity Issue - US-IAD", "status": "resolved", "created_at": "2026-06-26T17:14:32.425Z", "updated_at": "2026-06-26T19:33:10.810Z", "monitoring_at": null, "resolved_at": "2026-06-26T19:33:10.791Z", "impact": "none", "shortlink": "https://stspg.io/ksy92j8jw2vz", "started_at": "2026-06-26T17:14:32.415Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "kj6w4s2llddq", "status": "resolved", "body": "This incident has been resolved.", "incident_id": "q3x20njn3xlm", "created_at": "2026-06-26T19:33:10.791Z", "updated_at": "2026-06-26T19:33:10.791Z", "display_at": "2026-06-26T19:33:10.791Z", "affected_components": [{"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "wgrtx2gkclwk", "status": "investigating", "body": "Our team is investigating an issue affecting connectivity in our US-IAD data center. During this time, users may experience intermittent connection timeouts and errors for services deployed in this data center. We will share additional updates as we have more information.", "incident_id": "q3x20njn3xlm", "created_at": "2026-06-26T17:14:32.476Z", "updated_at": "2026-06-26T17:14:32.476Z", "display_at": "2026-06-26T17:14:32.476Z", "affected_components": [{"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "h9sk1q74fyb6", "name": "US-IAD (Washington)", "status": "operational", "created_at": "2023-07-05T17:50:17.524Z", "updated_at": "2026-08-19T05:30:15.228Z", "position": 5, "description": null, "showcase": false, "start_date": "2023-07-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "1h0hwggm668b", "name": "Emerging Service Issue - GPU Instances - All Regions", "status": "postmortem", "created_at": "2026-06-24T18:53:22.517Z", "updated_at": "2026-06-26T18:14:57.637Z", "monitoring_at": "2026-06-24T21:12:24.000Z", "resolved_at": "2026-06-25T19:29:32.481Z", "impact": "none", "shortlink": "https://stspg.io/nqpmptncw0ff", "started_at": "2026-06-24T18:53:22.451Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "vyyg2057khcm", "status": "postmortem", "body": "On June 23, 2026, following a global software deployment, we identified an issue causing intermittent boot failures specifically for GPU Linodes. The impact was limited to instances where multiple GPU Linodes attempted to boot simultaneously. During the impact window customers could have experienced localized disruption or elevated error rates, particularly during automated node recycling or scaling events.\n\nDuring the investigation it was found that a recent software update created a conflict when multiple GPU servers tried to start up at the exact same time. The servers essentially blocked one another from loading, and our system did not automatically trigger a retry. This specific interaction only happens under heavy, simultaneous workloads, which is why it wasn't caught during our standard pre-release testing.\n\nIn order to mitigate the issue, we successfully deployed a hotfix directly to all active GPU hosts across our fleet at 20:32 UTC on June 24th, 2026. The affected systems are currently operating normally as expected.\n\nIn order to prevent this issue from happening in the future, we have developed and integrated a comprehensive fix into our upcoming software release scheduled to roll out globally over the next week. Additionally, we are actively prioritizing the procurement of dedicated GPU testing hardware for our development cloud to improve test coverage and ensure concurrent hardware workloads are fully simulated before future updates reach production.\n\nThis summary provides an overview of our current understanding of the incident given the information available. Our investigation is ongoing and any information herein is subject to change.", "incident_id": "1h0hwggm668b", "created_at": "2026-06-26T18:14:41.931Z", "updated_at": "2026-06-26T18:14:57.635Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our June 24th incident: https://stspg.io/nqpmptncw0ff", "tweet_id": null}, {"id": "p2tmt1s0lfw1", "status": "resolved", "body": "We haven\u2019t observed any additional boot failures on GPU Instances in all regions, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "1h0hwggm668b", "created_at": "2026-06-25T19:29:32.481Z", "updated_at": "2026-06-25T19:29:32.481Z", "display_at": "2026-06-25T19:29:32.481Z", "affected_components": [{"code": "v8zpnn61fcdm", "name": "Regions - US-East (Newark)", "old_status": "operational", "new_status": "operational"}, {"code": "s8355f9s5hpx", "name": "Regions - US-Central (Dallas)", "old_status": "operational", "new_status": "operational"}, {"code": "v5mcdxdt9dtv", "name": "Regions - US-West (Fremont)", "old_status": "operational", "new_status": "operational"}, {"code": "ss2n92gy5xkk", "name": "Regions - US-Southeast (Atlanta)", "old_status": "operational", "new_status": "operational"}, {"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": "operational"}, {"code": "43zk807gj6fx", "name": "Regions - US-ORD (Chicago)", "old_status": "operational", "new_status": "operational"}, {"code": "ptln4fx0jhrt", "name": "Regions - CA-Central (Toronto)", "old_status": "operational", "new_status": "operational"}, {"code": "jzjmxld11n92", "name": "Regions - EU-West (London)", "old_status": "operational", "new_status": "operational"}, {"code": "bxcfhjdf5c4k", "name": "Regions - EU-Central (Frankfurt)", "old_status": "operational", "new_status": "operational"}, {"code": "19fvt94q0t57", "name": "Regions - FR-PAR (Paris)", "old_status": "operational", "new_status": "operational"}, {"code": "ymhgjx06c93n", "name": "Regions - AP-South (Singapore)", "old