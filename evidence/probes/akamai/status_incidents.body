 false}, {"id": "9qsy3z48wlm7", "name": "DE-HAM (Hamburg)", "status": "operational", "created_at": "2025-04-08T13:40:02.407Z", "updated_at": "2026-08-19T05:30:42.804Z", "position": 36, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "4j2hqzkcb5bw", "name": "US-HOU (Houston)", "status": "operational", "created_at": "2025-04-08T13:41:51.324Z", "updated_at": "2026-08-19T05:30:43.574Z", "position": 37, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "z8lp5jw3mjpb", "name": "MY-KUL (Kuala Lumpur)", "status": "operational", "created_at": "2025-04-08T13:42:25.784Z", "updated_at": "2026-08-19T05:30:44.821Z", "position": 38, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "qks0rqykcp34", "name": "FR-MRS (Marseille)", "status": "operational", "created_at": "2025-04-08T13:43:42.266Z", "updated_at": "2026-08-19T05:30:45.455Z", "position": 39, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "kzl6jczkb2tk", "name": "MX-QRO (Queretaro)", "status": "operational", "created_at": "2025-04-08T13:44:50.559Z", "updated_at": "2026-08-19T05:30:46.696Z", "position": 40, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "3rsd4fh24z48", "name": "CL-SCL (Santiago)", "status": "operational", "created_at": "2025-04-08T13:45:05.933Z", "updated_at": "2026-08-19T05:30:47.679Z", "position": 41, "description": null, "showcase": false, "start_date": "2025-04-08", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "gbwj4lm4196m", "name": "FR-PAR-2 (Paris 2)", "status": "operational", "created_at": "2026-01-06T15:34:24.715Z", "updated_at": "2026-08-19T05:30:48.666Z", "position": 42, "description": null, "showcase": false, "start_date": "2026-01-06", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "x1293sz7zyff", "name": "US-IAD-2 (Washington 2)", "status": "operational", "created_at": "2026-05-05T19:15:39.919Z", "updated_at": "2026-08-19T05:30:49.359Z", "position": 43, "description": null, "showcase": false, "start_date": "2026-05-05", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "c73p2yjscsnw", "name": "Investigating - Linode VM Migration Delays (All Regions)", "status": "postmortem", "created_at": "2026-05-15T02:24:01.000Z", "updated_at": "2026-05-15T06:32:45.788Z", "monitoring_at": null, "resolved_at": "2026-05-15T03:51:39.039Z", "impact": "none", "shortlink": "https://stspg.io/szvnnz2w3pr9", "started_at": "2026-05-15T02:24:01.000Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "5kdxftknwm04", "status": "postmortem", "body": "Starting around 04:00 UTC on May 14, 2026, Akamai identified an issue affecting Linode migration operations, including live, cold, and scheduled migrations. As a result, some customers experienced delays in migration processing, and customers undergoing certain migrations were temporarily unable to access their instances until processing resumed.\n\nThe issue was caused by an unexpected restart of internal services required to process migrations. Following the restart, those services did not automatically recover as expected, which prevented migration tasks from initiating and led to a backlog of stalled operations.\n\nAkamai engineers restored the affected services, and migration processing resumed. Service was largely restored at approximately 03:15 UTC on May 15, 2026.\n\nAkamai is continuing to investigate the underlying cause of the unexpected service restart and is reviewing monitoring and recovery procedures to help prevent similar issues in the future.\n\nThis summary reflects our current understanding of the incident based on available information. Our investigation is ongoing, and details may change as we learn more.", "incident_id": "c73p2yjscsnw", "created_at": "2026-05-15T06:32:35.388Z", "updated_at": "2026-05-15T06:32:45.785Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 15th incident: https://stspg.io/szvnnz2w3pr9", "tweet_id": null}, {"id": "k07cd4ncskxm", "status": "resolved", "body": "We have identified the root cause of the migration delays affecting all regions. An unexpected reboot of several internal infrastructure components at approximately 22:10 UTC on May 14 resulted in incomplete reinitialization, causing the migration queue to stall.The affected components have now been reinitialized and migrations are processing normally. The pending queue has cleared and both cold and warm migrations as well as resize jobs are confirmed moving.", "incident_id": "c73p2yjscsnw", "created_at": "2026-05-15T03:51:39.039Z", "updated_at": "2026-05-15T03:51:39.039Z", "display_at": "2026-05-15T03:51:39.039Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}, {"id": "m0kkdbh2z60f", "status": "investigating", "body": "We are currently investigating an issue causing delays to both cold and live migrations globally. A number of migrations are stuck, and additional migrations are queued and pending across all regions.\nCustomer Impact: Cold and live migrations along with linode resize may be delayed or unresponsive. We recommend avoiding initiating new migrations and resizes until this is resolved.\n\nWe are actively investigating the root cause and will provide an update shortly.", "incident_id": "c73p2yjscsnw", "created_at": "2026-05-15T02:24:01.385Z", "updated_at": "2026-05-15T03:06:15.389Z", "display_at": "2026-05-15T02:24:01.000Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "8dq1fcp7lwcj", "name": "Connectivity Issue - NL-AMS", "status": "resolved", "created_at": "2026-05-13T09:42:38.598Z", "updated_at": "2026-05-13T14:37:33.266Z", "monitoring_at": "2026-05-13T10:44:48.253Z", "resolved_at": "2026-05-13T14:37:33.250Z", "impact": "minor", "shortlink": "https://stspg.io/bg3nyt3bs4v8", "started_at": "2026-05-13T09:42:38.584Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "5cp0ks555pn3", "status": "resolved", "body": "We haven\u2019t observed any additional connectivity issues in our NL-AMS data center, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "8dq1fcp7lwcj", "created_at": "2026-05-13T14:37:33.250Z", "updated_at": "2026-05-13T14:37:33.250Z", "display_at": "2026-05-13T14:37:33.250Z", "affected_components": [{"code": "8w3v0zhrbx3z", "name": "Regions - NL-AMS (Amsterdam)", "old_status": "operational", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "srm3rd79nv78", "status": "monitoring", "body": "At this time we have been able to confirm that no customers should be impacted by the issues affecting connectivity in our NL-AMS data center. We will be monitoring this to ensure that it remains stable. If you are still experiencing issues, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "8dq1fcp7lwcj", "created_at": "2026-05-13T10:44:48.253Z", "updated_at": "2026-05-13T10:44:48.253Z", "display_at": "2026-05-13T10:44:48.253Z", "affected_components": [{"code": "8w3v0zhrbx3z", "name": "Regions - NL-AMS (Amsterdam)", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "t6yztl9xt90x", "status": "investigating", "body": "Our team is investigating an issue affecting connectivity in our NL-AMS data center. During this time, users may experience intermittent connection timeouts and errors for all services deployed in this data center. We will share additional updates as we have more information.", "incident_id": "8dq1fcp7lwcj", "created_at": "2026-05-13T09:42:38.731Z", "updated_at": "2026-05-13T09:42:38.731Z", "display_at": "2026-05-13T09:42:38.731Z", "affected_components": [{"code": "8w3v0zhrbx3z", "name": "Regions - NL-AMS (Amsterdam)", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "8w3v0zhrbx3z", "name": "NL-AMS (Amsterdam)", "status": "operational", "created_at": "2023-10-12T16:11:31.743Z", "updated_at": "2026-08-19T05:30:30.028Z", "position": 22, "description": null, "showcase": false, "start_date": "2023-10-12", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "422c79r5lbvd", "name": "Connectivity Issue - AP-West (Mumbai) and IN-MAA (Chennai)", "status": "postmortem", "created_at": "2026-05-12T17:12:30.000Z", "updated_at": "2026-05-14T15:11:06.882Z", "monitoring_at": null, "resolved_at": "2026-05-13T01:02:00.790Z", "impact": "minor", "shortlink": "https://stspg.io/j7tqwgf380d5", "started_at": "2026-05-12T17:12:30.000Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "3q443h3nwyqc", "status": "postmortem", "body": "On May 12, 2026, at approximately 14:50 UTC, Akamai began experiencing congestion and packet loss affecting traffic between India and Europe over Internet Service Provider network paths servicing our Mumbai and Chennai data centers. Customers may have seen intermittent connection timeouts and errors in the affected regions.\n\nThe issue was due to congestion on transit paths between India and Europe. Akamai worked with the involved Internet Service Providers and their upstream providers to identify the cause. To mitigate the impact, Akamai redirected traffic away from the affected paths, stabilizing service while the investigation continued.\n\nService was restored at the Mumbai data center at 19:23 UTC on May 12, 2026, and at the Chennai data center at 00:25 UTC on May 13, 2026.\n\nAkamai will continue working with the involved Internet Service Providers to address the underlying congestion and help prevent recurrence.\n\nThis summary reflects our current understanding of the incident based on available information. Our investigation is ongoing, and details may change as we learn more.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-14T15:10:44.424Z", "updated_at": "2026-05-14T15:11:06.879Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 12th incident: https://stspg.io/j7tqwgf380d5", "tweet_id": null}, {"id": "nv7474kxq0tv", "status": "resolved", "body": "This incident has been resolved. While we continue to monitor the upstream provider's progress on their underlying connectivity issue, our services are now stable on alternative paths.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-13T01:02:00.790Z", "updated_at": "2026-05-13T01:02:00.790Z", "display_at": "2026-05-13T01:02:00.790Z", "affected_components": [{"code": "cc7n9z4yz3gw", "name": "Regions - AP-West (Mumbai)", "old_status": "degraded_performance", "new_status": "operational"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "degraded_performance", "new_status": "operational"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "2b6glltljn0w", "status": "identified", "body": "We are continuing to work with our service provider on a fix for this issue.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-12T22:47:54.243Z", "updated_at": "2026-05-12T22:47:54.243Z", "display_at": "2026-05-12T22:47:54.243Z", "affected_components": [{"code": "cc7n9z4yz3gw", "name": "Regions - AP-West (Mumbai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "wz4xg4962fxg", "status": "identified", "body": "Our third-party service provider has identified the issue affecting connectivity in our AP-West (Mumbai) and IN-MAA (Chennai) data centers, and a fix is being implemented.  We will provide an update as soon as the solution is in place.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-12T19:52:48.341Z", "updated_at": "2026-05-12T19:52:48.341Z", "display_at": "2026-05-12T19:52:48.341Z", "affected_components": [{"code": "cc7n9z4yz3gw", "name": "Regions - AP-West (Mumbai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "5bxswgnvg9lm", "status": "investigating", "body": "We are continuing to investigate the issue with our service provider. We will share additional updates as we have more information.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-12T17:54:04.893Z", "updated_at": "2026-05-12T17:54:04.893Z", "display_at": "2026-05-12T17:54:04.893Z", "affected_components": [{"code": "cc7n9z4yz3gw", "name": "Regions - AP-West (Mumbai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "degraded_performance", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}, {"id": "g5krgjk1wflc", "status": "investigating", "body": "Our team is investigating an issue affecting connectivity in our AP-West (Mumbai) and IN-MAA (Chennai) data centers. During this time, users may experience intermittent connection timeouts and errors for all services deployed in these data centers. We will share additional updates as we have more information.", "incident_id": "422c79r5lbvd", "created_at": "2026-05-12T17:12:30.959Z", "updated_at": "2026-05-12T17:22:22.933Z", "display_at": "2026-05-12T17:12:30.000Z", "affected_components": [{"code": "cc7n9z4yz3gw", "name": "Regions - AP-West (Mumbai)", "old_status": "operational", "new_status": "degraded_performance"}, {"code": "k0thr1zd6smm", "name": "Regions - IN-MAA (Chennai)", "old_status": "operational", "new_status": "degraded_performance"}], "deliver_notifications": true, "custom_tweet": null, "tweet_id": null}], "components": [{"id": "cc7n9z4yz3gw", "name": "AP-West (Mumbai)", "status": "operational", "created_at": "2019-07-26T21:57:50.373Z", "updated_at": "2026-08-19T05:30:22.883Z", "position": 13, "description": null, "showcase": false, "start_date": null, "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}, {"id": "k0thr1zd6smm", "name": "IN-MAA (Chennai)", "status": "operational", "created_at": "2023-10-02T18:06:22.477Z", "updated_at": "2026-08-19T05:30:27.824Z", "position": 19, "description": null, "showcase": false, "start_date": "2023-10-02", "group_id": "kb0cf2d0rryb", "page_id": "8dn0wstr1chc", "group": false, "only_show_if_degraded": false}], "reminder_intervals": null}, {"id": "6zpngd7lrq4s", "name": "Service Issue - ACLP Logs", "status": "postmortem", "created_at": "2026-05-12T21:00:00.000Z", "updated_at": "2026-05-18T09:44:02.303Z", "monitoring_at": null, "resolved_at": "2026-05-12T23:15:00.000Z", "impact": "none", "shortlink": "https://stspg.io/17f3j6n2v5s7", "started_at": "2026-05-12T23:15:00.000Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "bs3pn6147yrd", "status": "postmortem", "body": "Between May 12 and May 14, 2026, Akamai Cloud Pulse \\(ACLP\\) experienced two related service interruptions that temporarily disrupted the ingestion and display of telemetry metrics specifically for Managed Databases.\n\n* Window 1: May 12, 23:15 UTC \u2013 May 13, 00:11 UTC\n* Window 2: May 14, 06:47 UTC \u2013 07:33 UTC\n\nDuring these windows, customers were unable to view Managed Database performance metrics within the Akamai Cloud Manager dashboards or retrieve them via external API and Collector streams. Metric-based alerting for Managed Databases was also impaired during both impact windows. We are currently evaluating whether the metrics data missing from these windows can be successfully backfilled.\n\nRemark: Metrics for other services, as well as the Log function, were unaffected and operated normally. Furthermore, this incident was strictly limited to the observability reporting layer. The performance, availability, and data integrity of customers\u2019 underlying Managed Databases were never impacted.\n\nThe disruption was caused by a cascading failure initiated by a brief network routing issue.\n\nDuring the initial event, a localized network disruption caused a small percentage of metrics traffic to fail to reach our processing endpoints. While the network disruption was brief, the accumulated backlog of automatic retries from the telemetry sender's built-in retry mechanism created a sudden, massive spike in traffic against the ingest endpoint.\u00a0\n\nThis \"retry storm\" overloaded the specific downstream message-queuing infrastructure responsible for processing and storing Managed Database telemetry. The processing pipeline was unable to handle the surge, causing the components to fail and leading to the complete loss of DBaaS ingestion \\(Window 1\\). The degraded performance observed two days later \\(Window 2\\) was the result of a separate, independent infrastructure incident within our telemetry partner's message-queuing service, entirely unrelated to the initial network disruption.\u00a0\n\nTo mitigate the issue, our engineering teams, working alongside our telemetry infrastructure partner, intervened to scale up the processing pipeline's configuration to absorb and clear the accumulated retry backlog. Following these actions, Managed Database metrics ingestion returned to normal levels.\n\nThis summary reflects our current understanding of the incident based on available information. Our investigation is ongoing, and details may change as we learn more.", "incident_id": "6zpngd7lrq4s", "created_at": "2026-05-18T09:41:22.708Z", "updated_at": "2026-05-18T09:44:02.301Z", "display_at": null, "affected_components": null, "deliver_notifications": true, "custom_tweet": "We published a postmortem on our May 12th incident: https://stspg.io/17f3j6n2v5s7", "tweet_id": null}, {"id": "0l4w3qx5jdtq", "status": "resolved", "body": "Our team became aware of an issue affecting the Cloud Pulse Metrics for Managed Databases (ACLP Metrics) for two short periods on May 12 and May 14, 2026, and a fix has been applied. We haven\u2019t observed any additional issues with the ACLP Metrics service, and will now consider this incident resolved. If you continue to experience problems, please <a href=\"https://cloud.linode.com/support/tickets\">open a Support ticket</a> for assistance.", "incident_id": "6zpngd7lrq4s", "created_at": "2026-05-15T10:21:54.623Z", "updated_at": "2026-05-15T14:42:13.546Z", "display_at": "2026-05-12T23:15:00.000Z", "affected_components": null, "deliver_notifications": false, "custom_tweet": null, "tweet_id": null}], "components": [], "reminder_intervals": null}, {"id": "msqh44ktjp9g", "name": "(Copy Fail) Linux Kernel Local Privilege Escalation Vulnerability [CVE-2026-31431]", "status": "resolved", "created_at": "2026-05-01T17:51:06.357Z", "updated_at": "2026-05-05T22:19:10.278Z", "monitoring_at": null, "resolved_at": "2026-05-05T22:19:10.243Z", "impact": "minor", "shortlink": "https://stspg.io/l5l21bbt8dp8", "started_at": "2026-05-01T17:51:06.105Z", "page_id": "8dn0wstr1chc", "incident_updates": [{"id": "7qzr03cxn14p", "status": "resolved", "body": "We have completed our investigation and response to the \u201cCopy Fail\u201d Linux kernel local privilege escalation vulnerability (CVE-2026-31431). We have published a documentation article with detailed guidance on available mitigations and recommended actions for affected systems. Customers can find more information and step-by-step instructions here: https://www.linode.com/docs/guides/cve-2026-31431-copy-fail-mitigation/\n\nWe encourage all customers to review the article and apply the appropriate mitigations to their environments. If you have questions or need assistance, please contact us at 855-454-6633 (+1-609-380-7100 Intl.) or email support@linode.com for assistance.", "incident_id": "msqh44ktjp9g", "created_at": "2026-05-05T22:19:10.243Z", "updated_at": "2026-05-05T22:19:10.243Z", "display_at": "2026-05-05T22:19:10.243Z", "affected_components": [{"code": "v8zpnn61fcdm", "name": "Regions - US-East (Newark)", "old_status": "operational", "new_status": "operational"}, {"code": "s8355f9s5hpx", "name": "Regions - US-Central (Dallas)", "old_status": "operational", "new_status": "operational"}, {"code": "v5mcdxdt9dtv", "name": "Regions - US-West (Fremont)", "old_status": "operational", "new_status": "operational"}, {"code": "ss2n92gy5xkk", "name": "Regions - US-Southeast (Atlanta)", "old_status": "operational", "new_status": "operational"}, {"code": "h9sk1q74fyb6", "name": "Regions - US-IAD (Washington)", "old_status": "operational", "new_status": 